{
  "name": "@niva/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Drizzle schema and migrations for PostgreSQL",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "node -e \"process.exit(0)\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node -e \"process.exit(0)\"",
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/migrate.ts",
    "grant-platform-admin": "tsx src/grant-platform-admin.ts"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.44.4",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@niva/config": "workspace:*",
    "@types/node": "^22.17.2",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.33.0",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2"
  }
}
