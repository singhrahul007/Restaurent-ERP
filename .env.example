# Local development only. Never commit a filled .env.

NODE_ENV=development
LOG_LEVEL=info

# PostgreSQL (required for API and migrations)
DATABASE_URL=postgresql://niva:niva@localhost:5432/niva

# Redis (API Socket.IO adapter + worker)
REDIS_URL=redis://localhost:6379

HOST=0.0.0.0
PORT=3001
CORS_ORIGINS=http://localhost:3000

NEXT_PUBLIC_API_URL=http://localhost:3001

# MinIO (S3-compatible)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=niva
S3_SECRET_KEY=nivalocalpass
S3_BUCKET=niva
S3_FORCE_PATH_STYLE=true

# Auth cookies / access JWT (min 32 chars). Local only.
JWT_ACCESS_SECRET=local-dev-jwt-access-secret-min-32-chars
COOKIE_SECURE=false

# Optional. After migrate, matching user gets is_platform_admin.
# PLATFORM_ADMIN_EMAIL=owner@example.com
