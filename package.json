{
  "name": "niva",
  "private": true,
  "version": "0.0.0",
  "description": "Niva multi-tenant restaurant operating system",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "turbo dev --filter=@niva/web --filter=@niva/api --filter=@niva/worker",
    "dev:web": "pnpm --filter @niva/web dev",
    "dev:api": "pnpm --filter @niva/api dev",
    "dev:worker": "pnpm --filter @niva/worker dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "build": "turbo build",
    "db:generate": "pnpm --filter @niva/database generate",
    "db:migrate": "pnpm --filter @niva/database migrate",
    "db:grant-platform-admin": "pnpm --filter @niva/database grant-platform-admin",
    "compose:up": "docker compose -f docker/compose.yml up -d",
    "compose:down": "docker compose -f docker/compose.yml down",
    "compose:ps": "docker compose -f docker/compose.yml ps"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "msgpackr-extract", "argon2"]
  }
}
